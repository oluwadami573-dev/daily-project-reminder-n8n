    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst priorityColor = {\n  High: '#e53935',\n  Medium: '#fb8c00',\n  Low: '#43a047'\n};\n\nlet rows = items.map(item => {\n  const p = item.json;\n  const color = priorityColor[p.Priority] || '#555';\n  return `\n    <tr>\n      <td style=\"padding:8px;border-bottom:1px solid #eee;\">${p.Project}</td>\n      <td style=\"padding:8px;border-bottom:1px solid #eee;\">${p.Status}</td>\n      <td style=\"padding:8px;border-bottom:1px solid #eee;\">${p.Deadline}</td>\n      <td style=\"padding:8px;border-bottom:1px solid #eee;color:${color};font-weight:bold;\">${p.Priority}</td>\n      <td style=\"padding:8px;border-bottom:1px solid #eee;\">${p.Notes || ''}</td>\n    </tr>`;\n}).join('');\n\nconst html = `\n  <h2>Your Active Projects</h2>\n  <table style=\"border-collapse:collapse;width:100%;font-family:Arial,sans-serif;\">\n    <tr style=\"background:#305496;color:white;\">\n      <th style=\"padding:8px;text-align:left;\">Project</th>\n      <th style=\"padding:8px;text-align:left;\">Status</th>\n      <th style=\"padding:8px;text-align:left;\">Deadline</th>\n      <th style=\"padding:8px;text-align:left;\">Priority</th>\n      <th style=\"padding:8px;text-align:left;\">Notes</th>\n    </tr>\n    ${rows}\n  </table>`;\n\nreturn [{ json: { emailBody: html } }];"
      },
